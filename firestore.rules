rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.3 Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation definitions
    function isValidMedication(data) {
      return data.clave is string
        && data.nombre is string
        && (data.keys().hasAny(['activo']) ? data.activo is bool : true)
        && (data.keys().hasAny(['fecha_caducidad']) ? (data.fecha_caducidad == null || data.fecha_caducidad is string) : true);
    }

    function isValidLogEntry(data) {
      return data.folio is string
        && data.medicationId is string
        && (data.keys().hasAny(['paciente']) ? (data.paciente == null || data.paciente is string) : true)
        && (data.keys().hasAny(['nombrePaciente']) ? (data.nombrePaciente == null || data.nombrePaciente is string) : true);
    }

    function isValidPatientRecord(data) {
      return data.nombreCompleto is string
        && data.cantidad is number;
    }

    function isValidConfig(data) {
      return true;
    }

    // Path logic
    match /user_roles/{email} {
      allow read, write: if isSignedIn();
    }

    match /medications/{medicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMedication(incoming());
      allow update: if isSignedIn() && isValidMedication(incoming());
      allow delete: if isSignedIn();
    }

    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLogEntry(incoming());
      allow update: if isSignedIn() && isValidLogEntry(incoming());
      allow delete: if isSignedIn();
    }

    match /patientsRegistry/{patientRecordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidPatientRecord(incoming());
      allow update: if isSignedIn() && isValidPatientRecord(incoming());
      allow delete: if isSignedIn();
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(configId)
        && isValidConfig(incoming());
      allow update: if isSignedIn()
        && isValidConfig(incoming());
      allow delete: if false;
    }
  }
}
